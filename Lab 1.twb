      <aliases enabled='yes' />
      <column caption='Review Perfomance Score' datatype='integer' name='[Calculation_0711162962829312]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Number Of Reviews] * [Review Scores Rating]' />
      </column>
      <column caption='Property Pricing Strategy' datatype='string' name='[Calculation_0711162963386369]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price] &gt;= 300 THEN &quot;Luxury&quot; ELSEIF [Price] &gt;= 150 THEN &quot;Standard&quot; ELSE &quot;Budget&quot; END' />
      </column>
      <column caption='Review Category' datatype='string' name='[Calculation_0711162964234242]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Number Of Reviews] &gt;= 100 THEN &quot;Highly Reviewed&quot; ELSE &quot;Less Reviewed&quot; END' />
      </column>
      <column caption='Host Status' datatype='string' name='[Calculation_0711162965114883]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Host Since] &lt;= TODAY() THEN &quot;Active Host&quot; ELSE &quot;New Host&quot; END' />
      </column>
      <column caption='Price Filter Category' datatype='string' name='[Calculation_0711162966626312]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price] &gt; [Parameters].[Parameter 0711162965626887] THEN &quot;Above Limit&quot; ELSE &quot;Below Limit&quot; END' />
      </column>
