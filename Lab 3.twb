      <aliases enabled='yes' />
      <column datatype='integer' hidden='true' name='[Beds]' role='measure' type='quantitative' />
      <column caption='Host_Since' datatype='date' name='[Calculation_0262787901612032]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IFNULL([Host Since], DATE(&quot;01-01-2010&quot;))' />
      </column>
      <column caption='Updated_neighbourhood' datatype='string' name='[Calculation_0262787907706881]' role='dimension' semantic-role='[City].[Name]' type='nominal'>
        <calculation class='tableau' formula='IFNULL([Neighbourhood], &quot;Unknown&quot;)' />
      </column>
      <column caption='Updated Review Score Rating (bin)' datatype='string' name='[Calculation_0262787909943298]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL(STR([Review Scores Rating (bin)]), &quot;Not Rated&quot;)' />
      </column>
      <column caption='Updated_beds' datatype='integer' name='[Calculation_0262787910549507]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([Beds], 0)' />
      </column>
      <column caption='Updated Review Score Rating' datatype='integer' name='[Calculation_0262787911045124]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([Review Scores Rating], 0)' />
      </column>
      <column caption='Updated Property Type' datatype='string' name='[Calculation_0262787936444421]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([Property Type],&quot;Unknown&quot;)' />
      </column>
      <column caption='Review Performance Score' datatype='integer' name='[Calculation_0822164092395520]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Number Of Reviews]*[Calculation_0262787911045124]' />
      </column>
      <column caption='Price Category' datatype='string' name='[Calculation_0822164093505538]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price] &gt;= 300 THEN &quot;Luxury&quot;&#13;&#10;ELSEIF [Price] &gt;= 150 THEN &quot;Standard&quot;&#13;&#10;ELSE &quot;Budget&quot;&#13;&#10;END' />
      </column>
      <column caption='Review Category' datatype='string' name='[Calculation_0822164095176707]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Number Of Reviews] &gt;= 100 THEN &quot;Highly Reviewed&quot;&#13;&#10;ELSE &quot;Less Reviewed&quot;&#13;&#10;END' />
      </column>
      <column caption='Host Status' datatype='string' name='[Calculation_0822164098043908]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Host Since] &lt;= TODAY() THEN &quot;Active Host&quot;&#13;&#10;ELSE &quot;New Host&quot;&#13;&#10;END' />
      </column>
      <column caption='Price Filter Category' datatype='string' name='[Calculation_0822164108189701]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price] &gt; [Parameters].[Neighbourhood Parameter]&#13;&#10;THEN &quot;Above Limit&quot;&#13;&#10;ELSE &quot;Below Limit&quot;&#13;&#10;END' />
      </column>
      <column caption='Updated_Host_since' datatype='date' name='[Calculation_0822164171472903]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='IFNULL(MIN([Host Since]),LOOKUP(MIN([Host Since]),-1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column datatype='integer' name='[Host Id]' role='dimension' type='ordinal' />
      <column datatype='date' hidden='true' name='[Host Since]' role='dimension' type='ordinal' />
