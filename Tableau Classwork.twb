      <aliases enabled='yes' />
      <column caption='Region ' datatype='boolean' name='[Calculation_0693845650915330]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Region]= [Parameters].[Parameter 0693845650608129]' />
      </column>
      <column caption='ifnull (segment)' datatype='string' name='[Calculation_0859871203217409]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([Segment],&apos;CS&apos;)' />
      </column>
      <column caption='Profit Ratio' datatype='real' name='[Calculation_0859871204438018]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Profit] / [Sales]' />
      </column>
      <column caption='Discount %' datatype='real' name='[Calculation_0859871204659203]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Discount] / [Sales]' />
      </column>
      <column caption='Previous Sales' datatype='real' name='[Calculation_0859871205158916]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Sales] - 100' />
      </column>
      <column caption='Sales Growth' datatype='real' name='[Calculation_0859871205281797]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Sales]- [Calculation_0859871205158916]) / [Calculation_0859871205158916]' />
      </column>
      <column caption='If Condition' datatype='string' name='[Calculation_0859871205634054]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Sales] &gt; 10000 THEN &quot;High&quot; ELSE &quot;Low&quot; END' />
      </column>
      <column caption='Case Statement' datatype='string' name='[Calculation_0859871206813703]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Segment] WHEN &quot;Consumer&quot; THEN &quot;C&quot; WHEN &quot;Corporate&quot; THEN &quot;B&quot; ELSE &quot;Other&quot; END' />
      </column>
      <column caption='Case Statement 1' datatype='string' name='[Calculation_0859871208538122]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Category] WHEN &quot;Clothing&quot; THEN &quot;C&quot; WHEN &quot;Sports&quot; THEN &quot;S&quot; ELSE &quot;Other&quot; END' />
      </column>
      <column caption='Case Statement 2' datatype='string' name='[Calculation_0859871209357323]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Sub-Category] WHEN &quot;Women&quot; THEN &quot;W&quot; WHEN &quot;Apparel&quot; THEN &quot;A&quot; ELSE &quot;Other&quot; END' />
      </column>
      <column caption='Date Calculation' datatype='integer' name='[Calculation_0859871209836556]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [Order Date], [Ship Date])' />
      </column>
      <column caption='Updated_sales_data' datatype='real' name='[Calculation_1139422439821312]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Unit Price] * [Quantity]' />
      </column>
      <column caption='sum sale filter' datatype='boolean' name='[Calculation_1139422457389070]' role='measure' type='nominal'>
        <calculation class='tableau' formula='SUM([Sales])&gt;= [Parameters].[Parameter 1139422457155597]' />
      </column>
      <column datatype='string' name='[City]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
      <column caption='Ship Mode - Split 1' datatype='string' name='[Ship Mode - Split 1]' role='dimension' type='nominal' user:SplitFieldIndex='1' user:SplitFieldOrigin='[federated.1t7p5kg0j6bqjl1b9myls0gndr9t].[Ship Mode]'>
        <calculation class='tableau' formula='TRIM( SPLIT( [Ship Mode], &quot; &quot;, 1 ) )' />
      </column>
      <column caption='Ship Mode - Split 2' datatype='string' name='[Ship Mode - Split 2]' role='dimension' type='nominal' user:SplitFieldIndex='2' user:SplitFieldOrigin='[federated.1t7p5kg0j6bqjl1b9myls0gndr9t].[Ship Mode]'>
        <calculation class='tableau' formula='TRIM( SPLIT( [Ship Mode], &quot; &quot;, 2 ) )' />
      </column>
      <column datatype='string' name='[State]' role='dimension' semantic-role='[State].[Name]' type='nominal' />
      <column datatype='string' name='[Sub-Category (group)]' role='dimension' type='nominal'>
        <calculation class='categorical-bin' column='[Sub-Category]' new-bin='true'>
          <bin default-name='false' value='&quot;Customer Segment&quot;'>
            <value>&quot;Kids&quot;</value>
            <value>&quot;Men&quot;</value>
            <value>&quot;Women&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;Dairy Products&quot;'>
            <value>&quot;Bakery&quot;</value>
            <value>&quot;Beverages&quot;</value>
            <value>&quot;Dairy&quot;</value>
            <value>&quot;Snacks&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;Electronics&quot;'>
            <value>&quot;Accessories&quot;</value>
            <value>&quot;Equipment&quot;</value>
            <value>&quot;Laptops&quot;</value>
            <value>&quot;Phones&quot;</value>
            <value>&quot;Tablets&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;Furniture&quot;'>
